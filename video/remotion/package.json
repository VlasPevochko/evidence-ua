{
  "name": "@evidence-ua/video-remotion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "test": "node --experimental-strip-types --test src/config/composition.test.ts src/evidence/validateEvidence.test.ts src/brand/theme.test.ts src/science/model.test.ts src/audio/providers.test.ts src/components/caption-model.test.ts src/compositions/creatine-journey/scene-plan.test.ts src/compositions/creatine-journey/voiceover.test.ts src/compositions/creatine-journey/scenes/scenes-1-4.test.ts src/compositions/creatine-journey/assembly.test.ts src/toolkit/contract.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "compositions": "remotion compositions src/index.ts",
    "voiceover:export": "node --experimental-strip-types src/tools/export-voiceover.ts",
    "voiceover:sample": "node --experimental-strip-types src/tools/export-voiceover.ts --sample",
    "toolkit:check": "node src/tools/toolkit-preflight.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/animated-emoji": "4.0.534",
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/lottie": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/node": "24.19.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
